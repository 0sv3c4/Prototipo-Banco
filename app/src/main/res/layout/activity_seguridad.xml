<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:fitsSystemWindows="false"
    tools:context=".Seguridad">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- TOOLBAR SUPERIOR -->
        <include
            android:id="@+id/toolbar_superior_acc"
            layout="@layout/toolbar_superior"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- CONTENIDO SCROLLABLE -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="180dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_superior_acc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- HEADER CON FONDO CURVO -->
                <FrameLayout
                    android:id="@+id/header_container"
                    android:layout_width="match_parent"
                    android:layout_height="100dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="-120dp"
                        android:background="@drawable/bg_bottom_curve"
                        android:backgroundTint="@color/ultra_claro" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="15dp"
                        android:text="@string/seguridad"
                        android:fontFamily="@font/inter_black"
                        android:textColor="@color/oscuro"
                        android:textSize="32sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="32dp"
                    android:layout_marginTop="16dp">

                    <!-- Accceso -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/acceso"
                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" />

                    <!-- Contraseña -->
                    <LinearLayout
                        android:id="@+id/opcion_contra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/contrase_a_de_acceso"
                                android:textColor="@color/neutro"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_bold" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_flecha"
                                app:tint="@color/black" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/modifica_tu_contrase_a"
                            android:textColor="@color/grisaceo"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" />

                    <!-- Face ID -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/face_id"
                                android:textColor="@color/neutro"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_bold" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_faceid_seg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="@color/white"
                                app:trackTint="@color/selector_color_switch" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activa_el_reconocimiento_facial_de_acceso"
                            android:textColor="@color/grisaceo"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" />

                    <!-- Huella -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/huella_dactilar"
                                android:textColor="@color/neutro"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_bold" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_huella_seg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                app:thumbTint="@color/white"
                                app:trackTint="@color/selector_color_switch" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activa_la_lectura_de_huella_de_acceso"
                            android:textColor="@color/grisaceo"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" />

                    <!-- Bloqueo -->
                    <LinearLayout
                        android:id="@+id/opcion_bloqueo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/bloqueo_autom_tico"
                                android:textColor="@color/neutro"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_bold" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_flecha"
                                app:tint="@color/black" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_bloqueo_estado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bloqueo_de_la_aplicaci_n_tras_1_minuto_de_inactividad"
                            android:textColor="@color/grisaceo"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Alertas de seguridad -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alertas_de_seguridad"
                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" />

                    <!-- Alertas de movimientos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/alerta_de_movimientos"
                                android:textColor="@color/neutro"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_bold" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_movimientos_seg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="@color/white"
                                app:trackTint="@color/selector_color_switch" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/notifica_cada_vez_que_se_aprueba_una_transferencia"
                            android:textColor="@color/grisaceo"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" />

                    <!-- Acceso sospechoso -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/acceso_sospechoso"
                                android:textColor="@color/neutro"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_bold" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_sospechoso_seg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="@color/white"
                                app:trackTint="@color/selector_color_switch" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detecci_n_de_fraude"
                            android:textColor="@color/grisaceo"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Sesión -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sesi_n"
                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="12dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sesiones_activas"
                                android:textColor="@color/neutro"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_bold" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_flecha"
                                app:tint="@color/black" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_de_dispositivos_conectados"
                            android:textColor="@color/grisaceo"
                            android:textSize="14sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" />

                    <LinearLayout
                        android:id="@+id/opcion_cerrar_sesion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/cerrar_sesi_n"
                                android:textColor="@color/neutro"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_bold" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_flecha"
                                app:tint="@color/black" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/desconectar_sesion"
                            android:textColor="@color/grisaceo"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_restablecer"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:text="@string/reestablecer_ajustes_predeterminados"
                        android:textAllCaps="false"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/claro"
                        app:cornerRadius="28dp" />

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Barra ifnerior -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:gravity="top|center"
                app:layout_constraintBottom_toBottomOf="parent">
                <View
                    android:layout_width="500dp"
                    android:layout_height="225dp"
                    android:background="@drawable/bg_bottom_curve" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="45dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_volver"
                    android:layout_width="210dp"
                    android:layout_height="64dp"
                    android:text="@string/volver"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:fontFamily="@font/inter_semibold"
                    app:backgroundTint="@color/claro"
                    app:cornerRadius="32dp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:id="@+id/nav_view"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_cabecera"
        app:menu="@menu/nav_menu"
        app:itemTextColor="@color/oscuro"
        app:itemTextAppearance="@style/boton_llamativo" />

</androidx.drawerlayout.widget.DrawerLayout>