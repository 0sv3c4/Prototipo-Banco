<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".Bizum">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- TOOLBAR SUPERIOR FIJA -->
        <include
            android:id="@+id/toolbar_superior_acc"
            layout="@layout/toolbar_superior"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- CONTENIDO SCROLEABLE -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_superior_acc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- HEADER CON LOGO -->
                <FrameLayout
                    android:id="@+id/header_container_bizum"
                    android:layout_width="match_parent"
                    android:layout_height="140dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="-100dp"
                        android:background="@drawable/bg_bottom_curve"
                        android:backgroundTint="@color/ultra_claro" />

                    <ImageView
                        android:id="@+id/iv_logo_bizum"
                        android:layout_width="250dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:contentDescription="@string/logo"
                        android:src="@drawable/logo_bizum" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/acciones_rapidas"
                        android:textAppearance="@style/titulo_seccion"
                        android:textSize="20sp"
                        android:textColor="@color/oscuro" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <ImageView
                                android:id="@+id/iv_enviar_dinero"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:background="@drawable/bg_circle_light_purple"
                                android:padding="15dp"
                                android:src="@drawable/ic_enviar_dinero"
                                app:tint="@color/oscuro" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/enviar_dinero"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/oscuro"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <ImageView
                                android:id="@+id/iv_solicitar_dinero"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:background="@drawable/bg_circle_light_purple"
                                android:padding="15dp"
                                android:src="@drawable/ic_pedir_dinero"
                                app:tint="@color/oscuro" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/solicitar_dinero"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/oscuro"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/contactos_recientes"
                            android:textAppearance="@style/titulo_seccion"
                            android:textSize="20sp"
                            android:textColor="@color/oscuro" />
                        <TextView
                            android:id="@+id/btn_ver_todos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ver_todos"
                            android:layout_alignParentEnd="true"
                            android:textColor="@color/oscuro"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"/>
                    </RelativeLayout>

                    <!-- Lista de contactos horizontales -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="4">
                        <LinearLayout
                            android:id="@+id/btn_contacto_m"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="@drawable/bg_circle_light_purple"
                                android:gravity="center"
                                android:text="@string/m"
                                android:textSize="24sp"
                                android:textColor="@color/black" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/manuel_a"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/btn_contacto_c"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="@drawable/bg_circle_light_purple"
                                android:gravity="center"
                                android:text="@string/c"
                                android:textSize="24sp"
                                android:textColor="@color/black" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/claudia_c"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/btn_contacto_j"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="@drawable/bg_circle_light_purple"
                                android:gravity="center"
                                android:text="@string/j"
                                android:textSize="24sp"
                                android:textColor="@color/black" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/juan_m"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/btn_contacto_o"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="@drawable/bg_circle_light_purple"
                                android:gravity="center"
                                android:text="@string/u00d3"
                                android:textSize="24sp"
                                android:textColor="@color/black" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/oscar_t"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Formulario -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/destinatario"
                        android:layout_marginTop="24dp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="18sp" />
                    <EditText
                        android:id="@+id/et_destinatario_bizum"
                        style="@style/cuadrado_rellenable"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:hint="@string/introduce_un_contacto"
                        android:inputType="text"
                        android:textColorHint="@color/claro" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/seleccionar_cantidad"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/tooltip_cantidad"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:src="@drawable/ic_tooltip"
                            app:tint="@color/black" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/et_cantidad_bizum"
                        style="@style/cuadrado_rellenable"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:hint="@string/saldo"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:textColorHint="@color/claro" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/concepto_opcional"
                        android:layout_marginTop="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="18sp" />
                    <EditText
                        android:id="@+id/et_concepto_bizum"
                        style="@style/cuadrado_rellenable"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:hint="@string/escribe_un_mensaje"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:textColorHint="@color/claro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirmar_bizum"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="24dp"
                        android:text="@string/confirmar"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/oscuro"
                        app:cornerRadius="30dp"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="18sp" />

                    <!-- Mensaje de error/éxito -->
                    <TextView
                        android:id="@+id/tv_mensaje_bizum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="150dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- TOOLBAR INFERIOR FIJA -->
        <include
            android:id="@+id/include_bottom_toolbar"
            layout="@layout/toolbar_inferior_clientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:id="@+id/nav_view"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_cabecera"
        app:menu="@menu/nav_menu"
        android:foregroundGravity="center"
        app:itemTextColor="@color/oscuro"
        app:itemTextAppearance="@style/boton_llamativo"/>

</androidx.drawerlayout.widget.DrawerLayout>