<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:fitsSystemWindows="false"
    tools:context=".Preferencias2">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- Barra superior -->
        <include
            android:id="@+id/toolbar_superior_acc"
            layout="@layout/toolbar_superior"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Contenido deslizable -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="180dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_superior_acc">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Fondo redondo crema -->
                <FrameLayout
                    android:id="@+id/header_container"
                    android:layout_width="match_parent"
                    android:layout_height="100dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="-120dp"
                        android:background="@drawable/bg_bottom_curve"
                        android:backgroundTint="@color/ultra_claro" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="10dp"
                        android:text="@string/preferencias"
                        android:fontFamily="@font/inter_black"
                        android:textColor="@color/oscuro"
                        android:textSize="32sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="40dp"
                    android:layout_marginTop="16dp">

                    <!-- Permisos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circle_light_purple"
                            android:backgroundTint="@color/mas_claro"
                            android:padding="10dp"
                            android:src="@android:drawable/ic_menu_preferences"
                            app:tint="@color/black" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/permisos"
                            android:textColor="@color/oscuro"
                            android:textSize="22sp"
                            android:fontFamily="@font/inter_bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="40dp">

                        <!-- Face ID -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/face_id"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_medium"
                                android:textColor="@color/black" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_faceid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="@color/white"
                                app:trackTint="@color/selector_color_switch" />
                        </LinearLayout>

                        <!-- Accesos directos -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/accesos_directos"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_medium"
                                android:textColor="@color/black" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_accesos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="@color/white"
                                app:trackTint="@color/selector_color_switch" />
                        </LinearLayout>

                        <!-- Bizum -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/bizum"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_medium"
                                android:textColor="@color/black" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_bizum"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="@color/white"
                                app:trackTint="@color/selector_color_switch" />
                        </LinearLayout>

                        <!-- Geolocalización -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/geolocalizaci_n"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_medium"
                                android:textColor="@color/black" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_geo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="@color/white"
                                app:trackTint="@color/selector_color_switch" />
                        </LinearLayout>

                        <!-- Notificaciones -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/notificaciones"
                                android:textSize="18sp"
                                android:fontFamily="@font/inter_medium"
                                android:textColor="@color/black" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/sw_notif"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                app:thumbTint="@color/white"
                                app:trackTint="@color/selector_color_switch" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Selección de foto de perfiL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="16dp">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circle_light_purple"
                            android:backgroundTint="@color/mas_claro"
                            android:padding="10dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:tint="@color/black" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/foto_de_perfil"
                            android:textColor="@color/oscuro"
                            android:textSize="22sp"
                            android:fontFamily="@font/inter_bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_importar"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            app:cardCornerRadius="30dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/mas_claro">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="40dp"
                                android:src="@android:drawable/stat_sys_download"
                                android:scaleType="centerInside"
                                app:tint="@color/black" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/importar_imagen"
                            android:textColor="@color/oscuro"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter_bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_aplicar_foto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/aplicar"
                            android:textAllCaps="false"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/neutro"
                            app:backgroundTint="@color/mas_claro"
                            app:cornerRadius="20dp"
                            android:minHeight="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Barra inferior -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:gravity="top|center"
                app:layout_constraintBottom_toBottomOf="parent">
                <View
                    android:layout_width="500dp"
                    android:layout_height="225dp"
                    android:background="@drawable/bg_bottom_curve" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="45dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_volver"
                    android:layout_width="160dp"
                    android:layout_height="64dp"
                    android:text="@string/volver"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/claro"
                    app:cornerRadius="32dp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_siguiente"
                    android:layout_width="160dp"
                    android:layout_height="64dp"
                    android:text="@string/siguiente"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/claro"
                    app:cornerRadius="32dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:id="@+id/nav_view"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_cabecera"
        app:menu="@menu/nav_menu"
        app:itemTextColor="@color/oscuro"
        app:itemTextAppearance="@style/boton_llamativo" />

</androidx.drawerlayout.widget.DrawerLayout>